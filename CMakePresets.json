{
    "version": 8,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 31
    },
    "configurePresets": [
        {
            "name": "debug-build",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_C_COMPILER": "/usr/local/opt/llvm/bin/clang",
                "CMAKE_C_STANDARD": "23",
                "CMAKE_C_EXTENSIONS": "ON",
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_COMPILE_WARNING_AS_ERROR": "ON",
                "CMAKE_RUNTIME_OUTPUT_DIRECTORY": "${sourceDir}/build",
                "NEU_INCLUDES": "${sourceDir}/src/include",
                "NEU_SRCS": "${sourceDir}/src"
            }
        },
        {
            "name": "release-build",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_C_COMPILER": "/usr/local/opt/llvm/bin/clang",
                "CMAKE_C_STANDARD": "23",
                "CMAKE_C_EXTENSIONS": "ON",
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_COMPILE_WARNING_AS_ERROR": "ON",
                "CMAKE_RUNTIME_OUTPUT_DIRECTORY": "${sourceDir}/build",
                "NEU_INCLUDES": "${sourceDir}/src/include",
                "NEU_SRCS": "${sourceDir}/src"
            }
        },
        {
            "name": "profile-build",
            "cacheVariables": {
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
                "CMAKE_C_COMPILER": "/usr/local/opt/llvm/bin/clang",
                "CMAKE_C_STANDARD": "23",
                "CMAKE_C_EXTENSIONS": "ON",
                "CMAKE_BUILD_TYPE": "RelWithDebInfo",
                "CMAKE_COMPILE_WARNING_AS_ERROR": "ON",
                "CMAKE_RUNTIME_OUTPUT_DIRECTORY": "${sourceDir}/build",
                "NEU_INCLUDES": "${sourceDir}/src/include",
                "NEU_SRCS": "${sourceDir}/src"
            }
        }
    ]
}